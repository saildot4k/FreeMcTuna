#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules
#
.*
*.a
*.diff
*.elf
*.ELF
*.erl
*.exe
*.irx
*.map
*.o
*.patch
*.rej
*.s
*.zip
*.ZIP
*.a
DETAILED_CHANGELOG

#
# files that we don't want to ignore
#
!.gitignore
!.gitattributes
!.github
!.editorconfig
!.clang-format
!.clang-format-ignore
!.mailmap
!/INSTALL/*

#
# Generated source files
#
*.toml
*.url
INSTALL/NEUTRINO/README.md

#
# INSTALL payload files that should be committed even though these extensions
# are ignored globally.
#
!/INSTALL/NEUTRINO/*.elf
!/INSTALL/NEUTRINO/**/*.toml
!/INSTALL/NEUTRINO/modules/*.irx
